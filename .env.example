# =============================================================================
# tradingbot 환경변수 예시 (.env.example)
#
#   복사해서 사용:  cp .env.example .env
#   .env 는 .gitignore 에 포함되어 커밋되지 않습니다. 키를 YAML/코드/로그에 절대 넣지 마세요.
#   값이 비어 있으면 "설정 안 됨" 으로 취급됩니다 (tradingbot.config.Credentials.from_env).
#   사용하는 브로커/알림의 변수만 채우면 됩니다. 공개 시세 조회는 키 없이도 동작합니다.
# =============================================================================

# ----------------------------------------------------------------------------- Upbit (업비트)
# 발급: upbit.com → 마이페이지 → Open API 관리. "자산조회 + 주문" 권한, 접속 IP 등록 필요
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# ----------------------------------------------------------------------------- ccxt (Binance 등)
# Binance: 계정 → API Management. 현물 거래 권한만 부여, 출금 권한은 절대 주지 말 것
CCXT_API_KEY=
CCXT_SECRET=
# OKX 등 passphrase 가 필요한 거래소만
CCXT_PASSWORD=
# 별칭: 위 대신 BINANCE_API_KEY / BINANCE_SECRET_KEY (또는 BINANCE_API_SECRET) 로 적어도 인식됩니다
# BINANCE_API_KEY=
# BINANCE_SECRET_KEY=

# ----------------------------------------------------------------------------- 한국투자증권 (KIS)
# 발급: apiportal.koreainvestment.com → API 신청. 모의투자(sandbox) 와 실전은 앱키가 다릅니다
KIS_APP_KEY=
KIS_APP_SECRET=
# 계좌번호: "12345678-01" (계좌번호-상품코드) 또는 "1234567801"
KIS_ACCOUNT_NO=
# HTS ID (일부 조회 API 에서 필요, 선택)
KIS_HTS_ID=

# ----------------------------------------------------------------------------- Alpaca (미국주식)
# 발급: app.alpaca.markets → API Keys. paper 키와 live 키가 다릅니다 (broker.sandbox 와 맞출 것)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# 별칭: APCA_API_KEY_ID / APCA_API_SECRET_KEY 도 인식됩니다
# APCA_API_KEY_ID=
# APCA_API_SECRET_KEY=

# ----------------------------------------------------------------------------- 알림
# 텔레그램: @BotFather 로 봇 생성 → 토큰. chat_id 는 봇에게 메시지 보낸 뒤 getUpdates 로 확인
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 슬랙 Incoming Webhook URL
SLACK_WEBHOOK_URL=
# 디스코드 채널 Webhook URL
DISCORD_WEBHOOK_URL=
